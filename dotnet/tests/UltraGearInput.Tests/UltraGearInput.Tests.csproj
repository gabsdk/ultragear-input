<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UltraGearInput.Core\UltraGearInput.Core.csproj" />
    <ProjectReference Include="..\..\src\UltraGearInput.Windows.Native\UltraGearInput.Windows.Native.csproj" />
    <ProjectReference Include="..\..\src\UltraGearInput.Linux\UltraGearInput.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\spec\protocol.json" Link="protocol.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\spec\fixtures\*.edid" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
